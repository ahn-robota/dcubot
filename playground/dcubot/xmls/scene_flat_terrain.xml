<mujoco model="scene">
    <include file="dcubot.xml"/>

    <visual>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
        <rgba haze="0.15 0.25 0.35 1"/>
        <global azimuth="160" elevation="-20"/>
    </visual>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="1 1 1" rgb2="1 1 1" width="800" height="800"/>
        <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="1 1 1" rgb2="1 1 1" markrgb="0 0 0"
            width="300" height="300"/>
        <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0"/>
    </asset>

    <worldbody>
        <body name="floor">
            <geom name="floor" size="0 0 0.01" type="plane" material="groundplane" contype="1" conaffinity="0"
                priority="1" friction="0.6" condim="3"/>
        </body>
    </worldbody>

    <!-- Standing pose matches the Placo reference motion's own standing recording
         (motions_dcubot/standing_0.0_0.0_0.0.json, steady-state average over the
         last 100 frames, L/R-symmetrized; com_height=0.19, trunk_pitch=5.5deg per
         that recording's Placo config). Root quat reordered from scipy's
         [x,y,z,w] (gait_generator.py's R.from_matrix(...).as_quat() convention)
         to MuJoCo's [w,x,y,z]. Joint order: left leg(5), right leg(5), head(3),
         matching this file's body declaration order. -->
    <keyframe>
        <key name="home"
            qpos="
    0 0 0.2495
    0.99885 0 0.04796 0
      0 0 0.0769 0.0365 -0.0173
      0 0 0.0769 0.0365 -0.0173
      0 0 0
"
            ctrl="
      0 0 0.0769 0.0365 -0.0173
      0 0 0.0769 0.0365 -0.0173
      0 0 0
      "/>
    </keyframe>
</mujoco>
