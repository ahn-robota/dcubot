<mujoco model="scene">
    <include file="dcubot.xml"/>

    <visual>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
        <rgba haze="0.15 0.25 0.35 1"/>
        <global azimuth="160" elevation="-20" offwidth="1920" offheight="1440"/>
    </visual>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="1 1 1" rgb2="1 1 1" width="800" height="800"/>
        <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="1 1 1" rgb2="1 1 1" markrgb="0 0 0"
            width="300" height="300"/>
        <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0"/>
    </asset>

    <worldbody>
        <body name="floor">
            <geom name="floor" size="0 0 0.01" type="plane" material="groundplane" contype="1" conaffinity="0"
                priority="1" friction="0.6" condim="3"/>
        </body>
    </worldbody>

    <!-- Standing pose for the final-URDF remodel (2.072kg, com_height=0.22):
         phase-averaged over the new reference's own zero-command
         (dx=dy=dtheta=0) combo, L/R-symmetrized (hip_yaw/hip_roll zeroed as
         noise, hip_pitch/knee/ankle averaged across both legs), base height
         solved so the feet land exactly on the floor. trunk_pitch=5.5deg
         unchanged from before. Root quat in MuJoCo's [w,x,y,z]. Joint order:
         left leg(5), right leg(5), head(3), matching this file's body
         declaration order. See docs/CHANGES_FROM_ORIGINAL.md. -->
    <keyframe>
        <key name="home"
            qpos="
    0 0 0.264145
    1 0 0 0
      0 0 -0.104527 0.050879 0.053608
      0 0 -0.104527 0.050879 0.053608
      0 0 0
"
            ctrl="
      0 0 -0.104527 0.050879 0.053608
      0 0 -0.104527 0.050879 0.053608
      0 0 0
      "/>
    </keyframe>
</mujoco>
